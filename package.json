{
  "name": "adorema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema contable, de inventario, trazabilidad y flujo de caja para licorera (Colombia)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "local": "node apps/local/servidor.js",
    "respaldo": "node apps/local/respaldo.js",
    "usuario": "node scripts/usuario.js",
    "servidor": "node --env-file=.env apps/local/servidor.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2"
  }
}
