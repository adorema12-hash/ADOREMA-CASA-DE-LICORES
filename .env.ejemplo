# Adorema — configuración del servidor
#
# Copia este archivo como `.env` en el servidor y llena los valores. En el
# computador del mostrador no hace falta nada de esto: `Adorema.cmd` arranca
# con la base local y sin contraseña, porque quien está frente al computador ya
# está adentro del negocio.
#
# El `.env` no va al repositorio (está en .gitignore): tiene la llave de la
# base de datos.
#
# ⚠ Los valores van ENTRE COMILLAS DOBLES. Sin comillas, un `#` en medio de una
# contraseña corta el valor ahí mismo —lo que sigue se toma por comentario— y
# no avisa: la conexión falla con un error que no se parece en nada a la causa.
# Con comillas, `#` y `$` pasan tal cual. Evita la barra invertida `\`.

# ---------------------------------------------------------------- la puerta
# No va aquí: los usuarios viven en la base de datos. Crea el primero en el
# servidor con `npm run usuario` — y sin al menos un administrador, el
# programa NO arranca si va a escuchar fuera de su computador.
#
#   npm run usuario            crear una cuenta
#   npm run usuario -- listar  ver las que hay
#   npm run usuario -- clave juan   cambiarle la contraseña a alguien

# ------------------------------------------------------------ la base de datos
# Cadena de conexión de PostgreSQL (Supabase la da hecha). Si se deja vacía,
# Adorema usa su base local en la carpeta `datos/`.
# Usa el «connection pooler» de Supabase (puerto 6543) para una máquina
# pequeña: mantiene menos conexiones abiertas.
DATABASE_URL="postgresql://usuario:contraseña@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Certificado de la autoridad de la base, si el proveedor lo entrega. Con él,
# la conexión además de ir cifrada comprueba con quién habla.
# ADOREMA_BASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Último recurso, si no hay certificado a mano: cifra pero no verifica.
# ADOREMA_BASE_SIN_VERIFICAR=0

# --------------------------------------------------------------- la escucha
# 127.0.0.1 es lo correcto cuando Caddy (o nginx) atiende internet y le pasa
# las peticiones. Sólo cambia a 0.0.0.0 si Adorema va a dar la cara al mundo,
# y en ese caso la contraseña es obligatoria.
ADOREMA_HOST="127.0.0.1"
ADOREMA_PUERTO="4300"

# Detrás de un proxy con HTTPS, para que la galleta de sesión viaje marcada
# como segura.
ADOREMA_HTTPS="1"

# Nombre que se ve en la pantalla de entrada.
ADOREMA_NEGOCIO="Licorera Adorema"

# --------------------------------------------------------------- las carpetas
# Los archivos que se suben (facturas, fotos de evidencia) y los respaldos
# diarios en JSON. En un servidor conviene que estén fuera del código, en un
# disco que se pueda respaldar aparte.
ADOREMA_ARCHIVOS="/var/lib/adorema/archivos"
ADOREMA_RESPALDOS="/var/lib/adorema/respaldos"
